# --- Runtime environment ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (see docker-compose.yml) ---
# API connects as pmagent_api (RLS enforced); worker as pmagent_worker (BYPASSRLS);
# migrations as the superuser.
API_DATABASE_URL=postgres://pmagent_api:pmagent_api@localhost:5432/pmagent
WORKER_DATABASE_URL=postgres://pmagent_worker:pmagent_worker@localhost:5432/pmagent
MIGRATE_DATABASE_URL=postgres://pmagent:pmagent@localhost:5432/pmagent
DATABASE_URL=postgres://pmagent:pmagent@localhost:5432/pmagent

# --- Redis (see docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- HTTP ---
API_PORT=8080
API_HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080

# --- Auth ---
JWT_SECRET=change-me-to-a-64-char-random-secret-in-production
JWT_TTL=8h

# --- LLM provider ---
# Provider: "anthropic" | "openai" | "mock"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=45000
# Hard cost cap per tenant per month (USD) for LLM spend guardrails
LLM_TENANT_MONTHLY_BUDGET_USD=100

# --- Notifications ---
# Provider: "twilio" | "smtp" | "msg91" | "telegram" | "console"
NOTIFY_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_URL=
SMTP_FROM=
# Operator/on-call inbox — where pm_alert and oncall escalations are delivered
SMTP_TO=

# --- MSG91 ---
MSG91_AUTHKEY=
MSG91_SENDER_ID=PMAENT
MSG91_API=https://api.msg91.com/api/sendsms.php

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Webhook security ---
# Optional shared secret. When set, /webhooks/* (non-Twilio) must send
#   X-Pma-Timestamp: <unix ms>  and  X-Pma-Signature: <hex(HMAC-SHA256(secret, "<ts>.<raw body>"))>
# Twilio SMS webhooks are verified with the Twilio signature when TWILIO_AUTH_TOKEN is set.
WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=

# --- Workers ---
# Concurrency per worker process
INGEST_CONCURRENCY=25
AGENT_CONCURRENCY=10
NOTIFY_CONCURRENCY=20
# Failures beyond this number move a job to the dead-letter queue
JOB_MAX_ATTEMPTS=5
# Stalled-ticket recovery: run the check every N minutes; nudge requests stuck
# in awaiting_info for more than STALL_AGE_MIN minutes; escalate after STALL_MAX nudges.
STALL_CHECK_INTERVAL_MIN=15
STALL_AGE_MIN=1440
STALL_MAX=2

# --- RAG / embeddings ---
# Provider: "mock" (offline, deterministic) | "openai"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
